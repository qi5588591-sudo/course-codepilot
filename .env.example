# Copy to .env. No credentials are shipped with this project.
CODEPILOT_API_BASE=https://your-provider.example/v1
CODEPILOT_API_KEY=
CODEPILOT_MODEL=
CODEPILOT_MODEL_TIMEOUT=60
CODEPILOT_DATABASE=artifacts/codepilot.sqlite3
CODEPILOT_SANDBOX_IMAGE=course-codepilot-sandbox:0.1
CODEPILOT_EXECUTION_TIMEOUT=15
# Optional local backend bearer token; set via the VS Code command: CodePilot: 设置后端令牌.
CODEPILOT_BACKEND_TOKEN=
